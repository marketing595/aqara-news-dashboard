# 아임웹 블로그 자동 포스팅 설정 서식
# 이 파일을 같은 폴더에 ".env" 이름으로 복사한 뒤 값을 채우세요. (.env 는 git/GitHub에 올리지 말 것)
#
#  점검 :  powershell -ExecutionPolicy Bypass -File .\Publish-ImwebPost.ps1 -Check
#  미리보기(전송 안 함) :
#          powershell -ExecutionPolicy Bypass -File .\Publish-ImwebPost.ps1 -File "..\..\drafts\2026-09-27-aqara-smarthome-package.html" -DryRun
#  실제 등록(비공개 초안) :
#          powershell -ExecutionPolicy Bypass -File .\Publish-ImwebPost.ps1 -File "..\..\drafts\2026-09-27-aqara-smarthome-package.html"

# ── 방식 선택 : legacy(구 API · API Key/Secret) 또는 oauth(Open API 2.0) ──
# 아카라라이프 계정은 이미 개발자센터 앱(OAuth2)으로 연동돼 있어 oauth 쪽이 확실합니다.
IMWEB_API_MODE=legacy

# ── 방식 1) legacy : 아임웹 관리자 > 개발자 > API 키 ──
IMWEB_API_KEY=
IMWEB_SECRET_KEY=

# ── 방식 2) oauth : 개발자센터(developers.imweb.me) 앱 + Get-ImwebToken.ps1 로 발급한 refresh token ──
IMWEB_CLIENT_ID=
IMWEB_CLIENT_SECRET=
IMWEB_REFRESH_TOKEN=
IMWEB_UNIT_CODE=

# ── 공통 ──
# 글을 올릴 게시판 코드 (아임웹 관리자 > 게시판 설정에서 확인)
IMWEB_BOARD_CODE=
IMWEB_AUTHOR=아카라라이프

# (선택) 엔드포인트를 직접 지정할 때만 사용
# IMWEB_API_BASE=https://openapi.imweb.me
# IMWEB_POSTS_PATH=/v2/board/posts
# IMWEB_CATEGORY=
